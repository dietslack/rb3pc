+bool VulkanTextureCache::BeginResolveWriteThrough(uint32_t dest_base, uint32_t dest_pitch_blocks,
+                                                  ResolveWriteThrough& write_through_out) {
+  if (!REXCVAR_GET(vulkan_resolve_write_through) || (dest_base & 0xFFF)) {
+    return false;
+  }
+  // The destination may also be within the texture (RB3 resolves some images
+  // in two halves).
+  auto it = resolve_write_through_textures_.upper_bound(dest_base >> 12);
+  if (it == resolve_write_through_textures_.begin()) {
+    return false;
+  }
+  --it;
+  VulkanTexture& texture = *it->second.texture;
+  uint32_t dest_offset = dest_base - (it->first << 12);
+  if (dest_offset >= texture.GetGuestBaseSize()) {
+    return false;
+  }
+  // Only if what's in the texture is current, then the parts not resolved
+  // stay current too.
+  if ((texture.outdated_mask() & Texture::kOutdatedBitBase) || IsTextureBaseOutdated(texture)) {
+    return false;
+  }
+  TextureKey texture_key = texture.key();
+  if (texture.guest_layout().base.row_pitch_bytes / 4 != dest_pitch_blocks) {
+    return false;
+  }
+  // Whole 32x32 macro tiles of 32bpp blocks are 4 KB, the tiled address
+  // offsets of the rest of the coordinates are the same within each.
+  uint32_t dest_offset_macro_tiles = dest_offset >> 12;
+  uint32_t pitch_macro_tiles = dest_pitch_blocks >> 5;
+  if (!pitch_macro_tiles) {
+    return false;
+  }
+  VkImageView storage_view = texture.GetStorageLoadView(0);
+  if (storage_view == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorSet image_descriptor_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageImageCompute);
+  if (image_descriptor_set == VK_NULL_HANDLE) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  VkDescriptorImageInfo image_info = {VK_NULL_HANDLE, storage_view, VK_IMAGE_LAYOUT_GENERAL};
+  VkWriteDescriptorSet write = {};
+  write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write.dstSet = image_descriptor_set;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  write.pImageInfo = &image_info;
+  vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(), 1, &write, 0,
+                                                    nullptr);
+
+  texture.MarkAsUsed();
+  // Only a part may be overwritten, keep the contents.
+  VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kStorageDestination);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kStorageDestination, dst_stage_mask,
+                       dst_access_mask, new_layout);
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(),
+      src_stage_mask ? src_stage_mask : VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, dst_stage_mask,
+      src_access_mask, dst_access_mask, old_layout, new_layout);
+
+  write_through_out.texture = &texture;
+  write_through_out.image_descriptor_set = image_descriptor_set;
+  write_through_out.endian = uint32_t(texture_key.endianness);
+  write_through_out.transform = uint32_t(it->second.transform);
+  write_through_out.width = texture_key.GetWidth() * draw_resolution_scale_x();
+  write_through_out.height = texture_key.GetHeight() * draw_resolution_scale_y();
+  write_through_out.origin_x =
+      (dest_offset_macro_tiles % pitch_macro_tiles) * 32 * draw_resolution_scale_x();
+  write_through_out.origin_y =
+      (dest_offset_macro_tiles / pitch_macro_tiles) * 32 * draw_resolution_scale_y();
   return true;
 }
 
+void VulkanTextureCache::EndResolveWriteThrough(const ResolveWriteThrough& write_through) {
+  MakeTextureBaseUpToDateAndWatch(*write_through.texture);
+}
+
+void VulkanTextureCache::VerifyResolveWriteThrough(const ResolveWriteThrough& write_through) {
+  if (resolve_write_through_verify_pipeline_ == VK_NULL_HANDLE ||
+      !resolve_write_through_verify_mapping_) {
+    return;
+  }
+  VulkanTexture& texture = *write_through.texture;
+  TextureKey texture_key = texture.key();
+  uint64_t source_start, source_range;
+  if (!GetScaledResolveRange(texture_key.base_page << 12, texture.GetGuestBaseSize(), 4,
+                             source_start, source_range)) {
+    return;
+  }
+  VkDescriptorSet sets[3] = {
+      command_processor_.AllocateSingleTransientDescriptor(
+          VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute),
+      command_processor_.AllocateSingleTransientDescriptor(
+          VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageImageCompute),
+      command_processor_.AllocateSingleTransientDescriptor(
+          VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute)};
+  if (sets[0] == VK_NULL_HANDLE || sets[1] == VK_NULL_HANDLE || sets[2] == VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  VkDescriptorBufferInfo source_info = {scaled_resolve_buffer_, source_start, source_range};
+  VkDescriptorImageInfo image_info = {VK_NULL_HANDLE, texture.GetStorageLoadView(0),
+                                      VK_IMAGE_LAYOUT_GENERAL};
+  VkDescriptorBufferInfo counter_info = {resolve_write_through_verify_buffer_, 0, VK_WHOLE_SIZE};
+  VkWriteDescriptorSet writes[3] = {};
+  for (uint32_t i = 0; i < 3; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = sets[i];
+    writes[i].descriptorCount = 1;
+  }
+  writes[0].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  writes[0].pBufferInfo = &source_info;
+  writes[1].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  writes[1].pImageInfo = &image_info;
+  writes[2].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  writes[2].pBufferInfo = &counter_info;
+  vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(), 3, writes, 0,
+                                                    nullptr);
+  UseScaledResolveBufferForRead();
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(),
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT,
+      VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+  command_processor_.SubmitBarriers(true);
+  uint32_t constants[5];
+  constants[0] = (uint32_t(texture_key.endianness) << 2) | (draw_resolution_scale_x() << 4) |
+                 (draw_resolution_scale_y() << 7);
+  constants[1] = texture.guest_layout().base.row_pitch_bytes / 4;
+  constants[2] = write_through.width;
+  constants[3] = write_through.height;
+  constants[4] = write_through.transform;
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(resolve_write_through_verify_pipeline_);
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         resolve_write_through_verify_pipeline_layout_, 0, 3, sets,
+                                         0, nullptr);
+  command_buffer.CmdVkPushConstants(resolve_write_through_verify_pipeline_layout_,
+                                    VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants), constants);
+  command_buffer.CmdVkDispatch((constants[2] + 31) / 32, (constants[3] + 15) / 16, 1);
+  ++resolve_write_through_verify_count_;
+  auto now = std::chrono::steady_clock::now();
+  if (now - resolve_write_through_verify_last_report_ >= std::chrono::seconds(2)) {
+    resolve_write_through_verify_last_report_ = now;
+    const volatile uint32_t* counters = resolve_write_through_verify_mapping_;
+    REXGPU_INFO(
+        "Resolve write-through verification: {} resolves, {} mismatching texels of {} "
+        "(first at {}x{})",
+        resolve_write_through_verify_count_, counters[0], counters[1], counters[2], counters[3]);
+  }
+}
