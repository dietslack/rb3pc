diff --git a/include/rex/system/shader_storage_progress.h b/include/rex/system/shader_storage_progress.h
new file mode 100644
index 0000000..9decd43
--- /dev/null
+++ b/include/rex/system/shader_storage_progress.h
@@ -0,0 +1,27 @@
+/**
+ * @file        rex/system/shader_storage_progress.h
+ * @brief       Progress of loading the persistent shader/pipeline storage.
+ *
+ * The GPU backend updates this while it recreates stored pipelines at launch
+ * (which can take a while when the driver has to compile them), so the app can
+ * show a loading screen.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex::system {
+
+struct ShaderStorageProgress {
+  // True from the start of shader storage initialization until it finishes.
+  std::atomic<bool> active{false};
+  // Pipelines to create; 0 while that's still being worked out.
+  std::atomic<uint32_t> total{0};
+  std::atomic<uint32_t> done{0};
+};
+
+ShaderStorageProgress& shader_storage_progress();
+
+}  // namespace rex::system
