+bool VulkanTextureCache::CanDeferResolveStore(const ResolveWriteThrough& write_through,
+                                              const ResolveRectangle& rectangle) const {
+  if (!REXCVAR_GET(vulkan_resolve_defer_store) ||
+      deferred_resolve_store_pipeline_ == VK_NULL_HANDLE || !write_through.target_count ||
+      deferred_resolve_stores_.size() >= 64) {
+    return false;
+  }
+  // Only from a texture having the same bits as the memory, and everything
+  // written must be in it.
+  const ResolveWriteThroughTarget& target = write_through.targets[0];
+  return target.transform == uint32_t(FusedLoadTransform::kNone) &&
+         target.origin_x + rectangle.x + rectangle.width <= target.width &&
+         target.origin_y + rectangle.y + rectangle.height <= target.height;
+}
+
+void VulkanTextureCache::DeferResolveStore(const ResolveWriteThrough& write_through,
+                                           const ResolveRectangle& rectangle,
+                                           uint32_t extent_start, uint32_t extent_length) {
+  const ResolveWriteThroughTarget& target = write_through.targets[0];
+  DeferredResolveStore& store = deferred_resolve_stores_.emplace_back();
+  store.rectangle = rectangle;
+  store.extent_start = extent_start;
+  store.extent_end = extent_start + extent_length;
+  store.texture = target.texture;
+  store.level = target.level;
+  store.origin_x = target.origin_x;
+  store.origin_y = target.origin_y;
+  store.frame = deferred_resolve_store_frame_;
+}
+
+void VulkanTextureCache::PrepareResolveOverDeferredStores(const ResolveRectangle& rectangle,
+                                                          uint32_t extent_start,
+                                                          uint32_t extent_length) {
+  uint32_t extent_end = extent_start + extent_length;
+  for (size_t i = 0; i < deferred_resolve_stores_.size();) {
+    const DeferredResolveStore& store = deferred_resolve_stores_[i];
+    if (store.extent_start >= extent_end || store.extent_end <= extent_start) {
+      ++i;
+      continue;
+    }
+    // With the same pitch and the bases whole 32x32 macro tiles apart, compare
+    // the rectangles in the same coordinates (for instance, RB3 resolves some
+    // images in two halves, their memory extents interleaved).
+    const ResolveRectangle& store_rectangle = store.rectangle;
+    uint32_t pitch_macro_tiles = rectangle.dest_pitch_blocks >> 5;
+    int64_t store_x = 0, store_y = 0;
+    bool comparable = store_rectangle.dest_pitch_blocks == rectangle.dest_pitch_blocks &&
+                      pitch_macro_tiles && !((store_rectangle.dest_base ^ rectangle.dest_base) & 0xFFF);
+    if (comparable) {
+      int64_t delta_macro_tiles =
+          (int64_t(store_rectangle.dest_base) - int64_t(rectangle.dest_base)) >> 12;
+      int64_t delta_rows = delta_macro_tiles >= 0
+                               ? delta_macro_tiles / pitch_macro_tiles
+                               : -((-delta_macro_tiles + pitch_macro_tiles - 1) / pitch_macro_tiles);
+      store_x = store_rectangle.x +
+                (delta_macro_tiles - delta_rows * pitch_macro_tiles) * 32 * draw_resolution_scale_x();
+      store_y = store_rectangle.y + delta_rows * 32 * draw_resolution_scale_y();
+      // Not wrapping to the next rows.
+      int64_t pitch_scaled = int64_t(rectangle.dest_pitch_blocks) * draw_resolution_scale_x();
+      comparable = store_x + store_rectangle.width <= pitch_scaled &&
+                   rectangle.x + rectangle.width <= pitch_scaled;
+    }
+    if (comparable &&
+        (store_x >= rectangle.x + rectangle.width || store_x + store_rectangle.width <= rectangle.x ||
+         store_y >= rectangle.y + rectangle.height ||
+         store_y + store_rectangle.height <= rectangle.y)) {
+      // Different pixels, not overwritten.
+      ++i;
+      continue;
+    }
+    bool overwritten = comparable && store_x >= rectangle.x && store_y >= rectangle.y &&
+                       store_x + store_rectangle.width <= rectangle.x + rectangle.width &&
+                       store_y + store_rectangle.height <= rectangle.y + rectangle.height;
+    if (!overwritten) {
+      StoreDeferredResolve(store);
+    }
+    deferred_resolve_stores_[i] = deferred_resolve_stores_.back();
+    deferred_resolve_stores_.pop_back();
+  }
+}
+
+void VulkanTextureCache::FlushDeferredResolveStores(uint32_t start, uint32_t length) {
+  uint32_t end = start + length;
+  for (size_t i = 0; i < deferred_resolve_stores_.size();) {
+    const DeferredResolveStore& store = deferred_resolve_stores_[i];
+    if (store.extent_start >= end || store.extent_end <= start) {
+      ++i;
+      continue;
+    }
+    StoreDeferredResolve(store);
+    deferred_resolve_stores_[i] = deferred_resolve_stores_.back();
+    deferred_resolve_stores_.pop_back();
+  }
+}
+
+void VulkanTextureCache::FlushDeferredResolveStoresOfTexture(const VulkanTexture& texture) {
+  for (size_t i = 0; i < deferred_resolve_stores_.size();) {
+    if (deferred_resolve_stores_[i].texture != &texture) {
+      ++i;
+      continue;
+    }
+    StoreDeferredResolve(deferred_resolve_stores_[i]);
+    deferred_resolve_stores_[i] = deferred_resolve_stores_.back();
+    deferred_resolve_stores_.pop_back();
+  }
+}
+
