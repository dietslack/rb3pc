+      progress.done.fetch_add(1);
+    });
+    SaveVkPipelineCache(true);
+  }
+
   REXGPU_INFO("Shader warm-up: compiled {} pipelines in {:.1f} s", compiled.load(),
               std::chrono::duration<double>(std::chrono::steady_clock::now() - start_time).count());
 }
