+bool VulkanRenderTargetCache::DoesDrawOverwriteTransfers(
+    uint32_t rt_index, const RenderTarget& render_target, const std::vector<Transfer>& transfers,
+    reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+    const float* rectangle) const {
+  const RegisterFile& regs = register_file();
+  // Every covered sample written: no discarding, no alpha test or alpha to
+  // coverage, all samples in the mask (depth / stencil also by depth-only
+  // draws).
+  xenos::EdramMode edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (next_draw_pixel_shader_kills_ ||
+      (edram_mode != xenos::EdramMode::kColorDepth &&
+       !(rt_index == 0 && edram_mode == xenos::EdramMode::kDepthOnly)) ||
+      (regs[XE_GPU_REG_PA_SC_AA_MASK] & 0xFFFF) != 0xFFFF) {
+    return false;
+  }
+  auto rb_colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+  if (rb_colorcontrol.alpha_test_enable || rb_colorcontrol.alpha_to_mask_enable) {
+    return false;
+  }
+  RenderTargetKey key = render_target.key();
+  if (rt_index == 0) {
+    // Depth replaced unconditionally, and the stencil (both formats have it)
+    // too.
+    uint32_t stencil_write_mask = (regs[XE_GPU_REG_RB_STENCILREFMASK] >> 16) & 0xFF;
+    if (!normalized_depth_control.z_enable || !normalized_depth_control.z_write_enable ||
+        normalized_depth_control.zfunc != xenos::CompareFunction::kAlways ||
+        !normalized_depth_control.stencil_enable || normalized_depth_control.backface_enable ||
+        normalized_depth_control.stencilfunc != xenos::CompareFunction::kAlways ||
+        normalized_depth_control.stencilzpass != xenos::StencilOp::kReplace ||
+        stencil_write_mask != 0xFF) {
+      return false;
+    }
+  } else {
+    uint32_t color_index = rt_index - 1;
+    float clamp[4];
+    uint32_t keep_mask[2];
+    GetPSIColorFormatInfo(key.GetColorFormat(), (normalized_color_mask >> (color_index * 4)) & 0b1111,
+                          clamp[0], clamp[1], clamp[2], clamp[3], keep_mask[0], keep_mask[1]);
+    if (keep_mask[0] || keep_mask[1] ||
+        (regs[reg::RB_BLENDCONTROL::rt_register_indices[color_index]] & 0x1FFF1FFF) !=
+            0x00010001) {
+      return false;
+    }
+  }
+  // The rectangle and the scissor containing every area transferred.
+  auto window_scissor_tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  auto window_scissor_br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  auto screen_scissor_tl = regs.Get<reg::PA_SC_SCREEN_SCISSOR_TL>();
+  auto screen_scissor_br = regs.Get<reg::PA_SC_SCREEN_SCISSOR_BR>();
+  if (window_scissor_tl.tl_x || window_scissor_tl.tl_y || screen_scissor_tl.tl_x ||
+      screen_scissor_tl.tl_y ||
+      (!window_scissor_tl.window_offset_disable && regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET])) {
+    return false;
+  }
+  uint32_t scissor_right = std::min(uint32_t(window_scissor_br.br_x), uint32_t(screen_scissor_br.br_x));
+  uint32_t scissor_bottom =
+      std::min(uint32_t(window_scissor_br.br_y), uint32_t(screen_scissor_br.br_y));
+  bool is_64bpp = !key.is_depth && xenos::IsColorRenderTargetFormat64bpp(key.GetColorFormat());
+  for (const Transfer& transfer : transfers) {
+    Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithoutCutout];
+    uint32_t rectangle_count = transfer.GetRectangles(key.base_tiles, key.pitch_tiles_at_32bpp,
+                                                      key.msaa_samples, is_64bpp, rectangles);
+    for (uint32_t i = 0; i < rectangle_count; ++i) {
+      const Transfer::Rectangle& r = rectangles[i];
+      uint32_t r_right = r.x_pixels + r.width_pixels;
+      uint32_t r_bottom = r.y_pixels + r.height_pixels;
+      if (rectangle[0] > float(r.x_pixels) || rectangle[1] > float(r.y_pixels) ||
+          rectangle[2] < float(r_right) || rectangle[3] < float(r_bottom) ||
+          scissor_right < r_right || scissor_bottom < r_bottom) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
