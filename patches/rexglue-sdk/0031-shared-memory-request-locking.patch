+void SharedMemory::MarkRangeTouchedThisSubmission(uint32_t start, uint32_t length) {
+  uint32_t page_first = start >> page_size_log2_;
+  uint32_t page_last = (start + length - 1) >> page_size_log2_;
+  for (uint32_t i = page_first >> 6; i <= page_last >> 6; ++i) {
+    uint64_t bits = UINT64_MAX;
+    if (i == page_first >> 6) bits &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    if (i == page_last >> 6 && (page_last & 63) != 63) {
+      bits &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    submission_touched_[i] |= bits;
+  }
+}
+
+bool SharedMemory::AreRangePagesValidUnlocked(uint32_t start, uint32_t length) const {
+  uint32_t page_first = start >> page_size_log2_;
+  uint32_t page_last = (start + length - 1) >> page_size_log2_;
+  for (uint32_t i = page_first >> 6; i <= page_last >> 6; ++i) {
+    uint64_t bits = UINT64_MAX;
+    if (i == page_first >> 6) bits &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    if (i == page_last >> 6 && (page_last & 63) != 63) {
+      bits &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    if ((__atomic_load_n(&system_page_flags_valid_[i], __ATOMIC_ACQUIRE) & bits) != bits) {
+      return false;
+    }
+  }
+  return true;
+}
+
 bool SharedMemory::RequestRange(uint32_t start, uint32_t length) {
+  // Most requests are for pages already in sync. The global critical region,
+  // which every guest thread synchronizing through kernel objects also takes,
+  // is only needed to change the page state: a CPU write invalidating a page
+  // completes (and lets the guest go on to submit the draw using it) only
+  // after the access violation handler has cleared the valid bit, so a draw
+  // can't see a page valid that its data hasn't been uploaded to. In RB3's
+  // songs, the command processor spent ~15% of its time waiting for the lock
+  // here.
+  if (length && start < kBufferSize && kBufferSize - start >= length &&
+      AreRangePagesValidUnlocked(start, length)) {
+    if (!EnsureHostGpuMemoryAllocated(start, length)) {
+      return false;
+    }
+    MarkRangeTouchedThisSubmission(start, length);
+    return true;
+  }
   std::pair<uint32_t, uint32_t> range(start, length);
   return RequestRanges(&range, 1);
 }
