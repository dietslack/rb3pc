+TextureCache::Texture* TextureCache::FindMipChainTextureForBase(const TextureKey& key) const {
+  // A plain 2D texture large enough for its base level not to be in a packed
+  // mip tail, so the base level is laid out the same with or without mips.
+  if (key.mip_page || key.mip_max_level ||
+      key.dimension != xenos::DataDimension::k2DOrStacked || key.GetDepthOrArraySize() != 1 ||
+      key.GetWidth() < 32 || key.GetHeight() < 32 || IsSignedVersionSeparateForFormat(key)) {
+    return nullptr;
+  }
+  auto chain_key_it = mip_chain_keys_.find(StripMipFields(key));
+  if (chain_key_it == mip_chain_keys_.end()) {
+    return nullptr;
+  }
+  auto texture_it = textures_.find(chain_key_it->second);
+  if (texture_it == textures_.end()) {
+    return nullptr;
+  }
+  return texture_it->second.get();
+}
