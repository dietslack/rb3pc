+/**
+ * @file        rex/system/shader_warmup.h
+ * @brief       Shaders to compile ahead of time, supplied by the title.
+ *
+ * The first draw with a new pixel shader makes the driver compile a pipeline,
+ * which can take most of a second and stalls the game. A title that knows its
+ * shaders (e.g. from its data files) can register them here; the GPU backend
+ * compiles a pipeline for each while loading the shader storage, into the
+ * persistent pipeline cache, so later draws with them are cache hits.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+namespace rex::system {
+
+struct ShaderWarmupPair {
+  // Guest-endian (big-endian) ucode dwords, as the title hands them to the GPU.
+  std::vector<uint32_t> vertex_ucode;
+  std::vector<uint32_t> pixel_ucode;
+};
+
+using ShaderWarmupSource = std::function<std::vector<ShaderWarmupPair>()>;
+
+// Called once, during shader storage initialization, on a loader thread.
+void SetShaderWarmupSource(ShaderWarmupSource source);
+const ShaderWarmupSource& GetShaderWarmupSource();
+
+}  // namespace rex::system
