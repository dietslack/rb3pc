+    }
+    uint32_t shift = from_log2 - to_log2;
+    return (value + (round_up ? (UINT32_C(1) << shift) - 1 : 0)) >> shift;
+  };
+  uint32_t left = convert(source_rectangle.x_pixels, source_tile_width_log2,
+                          dest_tile_width_log2, true);
+  uint32_t top = convert(source_rectangle.y_pixels, source_tile_height_log2,
+                         dest_tile_height_log2, true);
+  uint32_t right = convert(source_rectangle.x_pixels + source_rectangle.width_pixels,
+                           source_tile_width_log2, dest_tile_width_log2, false);
