+                          float(std::min(uint32_t(window_scissor_br.br_y),
+                                         uint32_t(screen_scissor_br.br_y))));
+  if (!(right > left) || !(bottom > top)) {
+    return false;
+  }
+  covered_out.x_pixels = uint32_t(left);
+  covered_out.y_pixels = uint32_t(top);
+  covered_out.width_pixels = uint32_t(right) - uint32_t(left);
+  covered_out.height_pixels = uint32_t(bottom) - uint32_t(top);
+  return true;
