+uint32_t DrawExtentEstimator::EvaluateUniformPixelShader(const Shader& pixel_shader,
+                                                         const UniformInterpolators& interpolators,
+                                                         uint32_t interpolator_mask,
+                                                         float (&colors_out)[4][4]) {
+  assert_true(pixel_shader.is_ucode_analyzed());
+  if ((interpolator_mask & ~interpolators.mask) ||
+      !ShaderInterpreter::CanInterpretShader(pixel_shader)) {
+    return 0;
+  }
+  shader_interpreter_.SetShader(pixel_shader);
+  // Interpolators in the first registers, the rest are temporaries (zero like
+  // in the translated shaders).
+  float* temp_registers = shader_interpreter_.temp_registers();
+  std::memset(temp_registers, 0, sizeof(float) * 4 * xenos::kMaxShaderTempRegisters);
+  for (uint32_t i = 0; i < xenos::kMaxInterpolators; ++i) {
+    if (interpolator_mask & (UINT32_C(1) << i)) {
+      std::memcpy(temp_registers + 4 * i, interpolators.values[i], sizeof(float) * 4);
+    }
+  }
+  ColorExportSink export_sink;
+  shader_interpreter_.SetExportSink(&export_sink);
+  shader_interpreter_.Execute();
+  shader_interpreter_.SetExportSink(nullptr);
+  uint32_t colors_written = 0;
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (export_sink.colors_written[i] == 0b1111) {
+      std::memcpy(colors_out[i], export_sink.colors[i], sizeof(float) * 4);
+      colors_written |= UINT32_C(1) << i;
+    }
+  }
+  return colors_written;
+}
