+  uint32_t source_tile_height_log2 = source_key.msaa_samples >= xenos::MsaaSamples::k2X ? 3 : 4;
+  uint32_t dest_tile_height_log2 = dest_key.msaa_samples >= xenos::MsaaSamples::k2X ? 3 : 4;
