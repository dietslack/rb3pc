+void MnkInputDriver::OnMouseWheel(rex::ui::MouseEvent& e) {
+  if (!IsEnabled() || !has_focus_ || !REXCVAR_GET(mnk_wheel_dpad))
+    return;
+  // scroll_y is kScrollPerDetent per notch, positive away from the user.
+  // Smooth scrolling (touchpads) arrives in fractions, so it's summed. A few
+  // notches queue up; a long spin doesn't scroll on forever.
+  constexpr int32_t kNotch = int32_t(rex::ui::MouseEvent::kScrollPerDetent);
+  int32_t notches;
+  {
+    std::lock_guard lock(state_mutex_);
+    wheel_accum_ += e.scroll_y();
+    notches = wheel_accum_ / kNotch;
+    wheel_accum_ -= notches * kNotch;
+  }
+  if (!notches)
+    return;
+  {
+    std::lock_guard lock(wheel_handler_mutex);
+    if (wheel_handler && wheel_handler(notches))
+      return;
+  }
+  for (int32_t i = 0; i < std::min(std::abs(notches), 4); ++i) {
+    QueuePress(notches > 0 ? X_INPUT_GAMEPAD_DPAD_UP : X_INPUT_GAMEPAD_DPAD_DOWN);
+  }
+}
