+// QueuePress: presses still to send, and the one being sent. Each is held,
+// then released, for a set time so a game polling at its own rate sees every
+// press.
+std::mutex press_mutex;
+std::deque<uint16_t> press_queue;
+uint16_t press_current = 0;
+std::chrono::steady_clock::time_point press_start{};
+
+// The buttons queued presses hold right now.
+uint16_t QueuedButtons() {
+  constexpr auto kHold = std::chrono::milliseconds(50), kGap = std::chrono::milliseconds(40);
+  std::lock_guard lock(press_mutex);
+  auto now = std::chrono::steady_clock::now();
+  if (press_current && now - press_start >= kHold + kGap) press_current = 0;
+  if (!press_current && !press_queue.empty()) {
+    press_current = press_queue.front();
+    press_queue.pop_front();
+    press_start = now;
+  }
+  return press_current && now - press_start < kHold ? press_current : 0;
+}
+
+}  // namespace
+
+void QueuePress(uint16_t buttons) {
+  std::lock_guard lock(press_mutex);
+  if (buttons && press_queue.size() < 8) press_queue.push_back(buttons);
+}
+
+bool PressesPending() {
+  std::lock_guard lock(press_mutex);
+  return press_current || !press_queue.empty();
+}
+
+namespace {
+std::mutex wheel_handler_mutex;
+std::function<bool(int32_t)> wheel_handler;
+}  // namespace
+
+void SetWheelHandler(std::function<bool(int32_t notches)> handler) {
+  std::lock_guard lock(wheel_handler_mutex);
+  wheel_handler = std::move(handler);
+}
+
+namespace {
+std::mutex click_mutex;
+std::function<bool(int, uint16_t&)> click_handler;
+// Presses the click handler took, per mouse button: what they hold, and
+// until when once released (a short click still lasts a few game polls).
+struct ClickOverride {
+  bool active = false, released = false;
+  uint16_t buttons = 0;
+  std::chrono::steady_clock::time_point until{};
+};
+ClickOverride click_overrides[3];
+constexpr auto kMinClickHold = std::chrono::milliseconds(60);
+
+int MouseButtonIndex(rex::ui::MouseEvent::Button button) {
+  switch (button) {
+    case rex::ui::MouseEvent::Button::kLeft:
+      return 0;
+    case rex::ui::MouseEvent::Button::kRight:
+      return 1;
+    case rex::ui::MouseEvent::Button::kMiddle:
+      return 2;
+    default:
+      return -1;
+  }
+}
+
+// On a mouse button press: whether the click handler takes it.
+bool TakeClick(int index) {
+  std::lock_guard lock(click_mutex);
+  uint16_t buttons = 0;
+  if (index < 0 || !click_handler || !click_handler(index, buttons))
+    return false;
+  click_overrides[index] = {true, false, buttons,
+                            std::chrono::steady_clock::now() + kMinClickHold};
+  return true;
+}
+
+// On its release: whether the press was taken.
+bool ReleaseClick(int index) {
+  std::lock_guard lock(click_mutex);
+  if (index < 0 || !click_overrides[index].active)
+    return false;
+  click_overrides[index].released = true;
+  return true;
+}
+
+// The buttons taken presses hold right now.
+uint16_t ClickButtons() {
+  std::lock_guard lock(click_mutex);
+  auto now = std::chrono::steady_clock::now();
+  uint16_t buttons = 0;
+  for (auto& o : click_overrides) {
+    if (o.active && o.released && now >= o.until)
+      o = {};
+    if (o.active)
+      buttons |= o.buttons;
+  }
+  return buttons;
+}
 }  // namespace
 
+void SetClickHandler(std::function<bool(int mouse_button, uint16_t& buttons)> handler) {
+  std::lock_guard lock(click_mutex);
+  click_handler = std::move(handler);
+}
