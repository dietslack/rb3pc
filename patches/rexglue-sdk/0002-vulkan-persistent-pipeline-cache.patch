+void VulkanPipelineCache::LoadVkPipelineCache(const std::filesystem::path& path) {
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  if (vk_pipeline_cache_ != VK_NULL_HANDLE) {
+    SaveVkPipelineCache(true);
+    dfn.vkDestroyPipelineCache(vulkan_device->device(), vk_pipeline_cache_, nullptr);
+    vk_pipeline_cache_ = VK_NULL_HANDLE;
+  }
+  vk_pipeline_cache_path_ = path;
+
+  // The driver validates the header (vendor, device, driver UUID) and ignores
+  // data from another GPU or driver version.
+  std::vector<uint8_t> data;
+  if (FILE* file = rex::filesystem::OpenFile(path, "rb")) {
+    fseek(file, 0, SEEK_END);
+    long size = ftell(file);
+    fseek(file, 0, SEEK_SET);
+    if (size > 0) {
+      data.resize(size_t(size));
+      if (fread(data.data(), 1, data.size(), file) != data.size()) data.clear();
+    }
+    fclose(file);
+  }
+  VkPipelineCacheCreateInfo create_info = {};
+  create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+  create_info.initialDataSize = data.size();
+  create_info.pInitialData = data.empty() ? nullptr : data.data();
+  if (dfn.vkCreatePipelineCache(vulkan_device->device(), &create_info, nullptr,
+                                &vk_pipeline_cache_) != VK_SUCCESS) {
+    // Retry empty in case the driver rejected the data outright.
+    create_info.initialDataSize = 0;
+    create_info.pInitialData = nullptr;
+    if (dfn.vkCreatePipelineCache(vulkan_device->device(), &create_info, nullptr,
+                                  &vk_pipeline_cache_) != VK_SUCCESS) {
+      vk_pipeline_cache_ = VK_NULL_HANDLE;
+    }
+  }
+  vk_pipeline_cache_unsaved_ = 0;
+  vk_pipeline_cache_saved_size_ = data.size();
+  vk_pipeline_cache_last_save_ = std::chrono::steady_clock::now();
+  REXGPU_INFO("VulkanPipelineCache: loaded {} bytes of driver pipeline cache from {}",
+              data.size(), rex::path_to_utf8(path));
+}
+
+void VulkanPipelineCache::SaveVkPipelineCache(bool force) {
+  if (vk_pipeline_cache_ == VK_NULL_HANDLE || vk_pipeline_cache_path_.empty()) return;
+  std::lock_guard<std::mutex> lock(vk_pipeline_cache_save_lock_);
+  if (vk_pipeline_cache_unsaved_.load(std::memory_order_relaxed) == 0) return;
+  auto now = std::chrono::steady_clock::now();
+  if (!force && now - vk_pipeline_cache_last_save_ < std::chrono::seconds(10)) return;
+  uint32_t unsaved = vk_pipeline_cache_unsaved_.exchange(0);
+
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  size_t size = 0;
+  if (dfn.vkGetPipelineCacheData(vulkan_device->device(), vk_pipeline_cache_, &size, nullptr) !=
+          VK_SUCCESS ||
+      !size || size == vk_pipeline_cache_saved_size_) {
+    return;
+  }
+  std::vector<uint8_t> data(size);
+  if (dfn.vkGetPipelineCacheData(vulkan_device->device(), vk_pipeline_cache_, &size,
+                                 data.data()) != VK_SUCCESS) {
+    return;
+  }
+  // Write to a temporary file and rename, so a kill mid-write can't leave a
+  // truncated cache behind.
+  auto temp_path = vk_pipeline_cache_path_;
+  temp_path += ".tmp";
+  FILE* file = rex::filesystem::OpenFile(temp_path, "wb");
+  if (!file) return;
+  bool ok = fwrite(data.data(), 1, size, file) == size;
+  ok = (fclose(file) == 0) && ok;
+  std::error_code ec;
+  if (ok) std::filesystem::rename(temp_path, vk_pipeline_cache_path_, ec);
+  if (ok && !ec) vk_pipeline_cache_saved_size_ = size;
+  vk_pipeline_cache_last_save_ = now;
+  REXGPU_DEBUG("VulkanPipelineCache: saved {} bytes ({} new pipelines)", size, unsaved);
+}
