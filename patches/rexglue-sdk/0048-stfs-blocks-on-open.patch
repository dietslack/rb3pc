+void StfsContainerDevice::ResolveBlocks(StfsContainerEntry* entry) {
+  std::lock_guard lock(io_mutex_);
+  if (!entry->blocks_pending_) {
+    return;
+  }
+  entry->blocks_pending_ = false;
+  // Blocks that follow each other in the file share one record (reads walk
+  // the records, so fewer is faster, and a big file has thousands of
+  // blocks). A contiguous file's blocks are consecutive: no hash tables.
+  auto& records = entry->block_list_;
+  auto add_block = [&records](size_t offset, size_t size) {
+    if (!records.empty() && records.back().file == 0 &&
+        records.back().offset + records.back().length == offset) {
+      records.back().length += size;
+    } else {
+      records.push_back({0, offset, size});
+    }
+  };
+  uint32_t block_index = entry->start_block_;
+  size_t remaining_size = entry->data_size_;
+  size_t block_count = 0;
+  if (entry->contiguous_) {
+    while (remaining_size) {
+      size_t block_size = std::min(static_cast<size_t>(kBlockSize), remaining_size);
+      add_block(BlockToOffsetSTFS(block_index), block_size);
+      remaining_size -= block_size;
+      ++block_index;
+      ++block_count;
+    }
+  } else {
+    while (remaining_size && block_index != kEndOfChain) {
+      size_t block_size = std::min(static_cast<size_t>(kBlockSize), remaining_size);
+      add_block(BlockToOffsetSTFS(block_index), block_size);
+      remaining_size -= block_size;
+      ++block_count;
+      auto block_hash = GetBlockHash(block_index);
+      if (!block_hash) {
+        break;
+      }
+      block_index = block_hash->level0_next_block();
+    }
+  }
+
+  if (remaining_size) {
+    // Loop above must have exited prematurely, bad hash tables?
+    REXFS_WARN("STFS file {} only found {} bytes for file, expected {} ({} bytes missing)",
+               entry->name_, entry->data_size_ - remaining_size, entry->data_size_, remaining_size);
+  }
+  // Check that the number of blocks retrieved from hash entries matches the
+  // block count read from the file entry
+  if (block_count != entry->allocated_blocks_) {
+    REXFS_WARN("STFS failed to read correct block-chain for entry {}, read {} blocks, expected {}",
+               entry->name_, block_count, entry->allocated_blocks_);
+  }
+}
