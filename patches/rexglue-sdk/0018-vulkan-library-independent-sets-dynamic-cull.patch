+VkPipelineLayout VulkanCommandProcessor::GetLibraryPipelineLayout(
+    bool vertex_side, VkDescriptorSetLayout textures_set_layout) {
+  uint64_t key = (uint64_t(textures_set_layout) << 1) | uint64_t(vertex_side);
