+size_t ContentManager::AddPackageFolder(const std::filesystem::path& folder) {
+  std::error_code ec;
+  size_t count = 0;
+  for (auto it = std::filesystem::recursive_directory_iterator(
+           folder, std::filesystem::directory_options::skip_permission_denied, ec);
+       !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec)) {
+    if (!it->is_regular_file(ec)) {
+      continue;
+    }
+    std::unique_ptr<rex::filesystem::StfsHeader> header =
+        rex::filesystem::StfsContainerDevice::ReadPackageHeader(it->path());
+    if (!header) {
+      continue;
+    }
+    PackageFile package_file;
+    package_file.path = it->path();
+    package_file.content_type = header->metadata.content_type;
+    package_file.display_name = header->metadata.display_name(XLanguage::kEnglish);
+    if (package_file.display_name.empty()) {
+      package_file.display_name = rex::path_to_utf16(it->path().filename());
+    }
+    // Unique within the 42 characters of XCONTENT_DATA (the host file name
+    // if it fits, otherwise its start and a hash of the whole path).
+    std::string file_name = rex::path_to_utf8(it->path().filename());
+    auto name_taken = [this, &file_name, &package_file]() {
+      return std::any_of(package_files_.cbegin(), package_files_.cend(),
+                         [&](const PackageFile& other) {
+                           return other.content_type == package_file.content_type &&
+                                  rex::string::utf8_equal_case(other.file_name, file_name);
+                         });
+    };
+    if (file_name.size() > 42 || name_taken()) {
+      file_name = fmt::format("{}_{:08X}", file_name.substr(0, 33),
+                              uint32_t(std::hash<std::string>{}(rex::path_to_utf8(it->path()))));
+    }
+    package_file.file_name = std::move(file_name);
+    // Packages for other titles (such as songs exported from earlier Rock
+    // Band games) are the running game's to accept or not, licenses
+    // included.
+    package_file.license_mask = 0xFFFFFFFF;
+    package_files_.push_back(std::move(package_file));
+    ++count;
+  }
+  return count;
+}
+
+const ContentManager::PackageFile* ContentManager::FindPackageFile(
+    const XCONTENT_AGGREGATE_DATA& data) const {
+  uint64_t xuid = data.xuid;
+  if (package_files_.empty() || (xuid != 0 && xuid != uint64_t(-1))) {
+    return nullptr;
+  }
+  std::string file_name = data.file_name();
+  for (const PackageFile& package_file : package_files_) {
+    if (package_file.content_type == data.content_type &&
+        rex::string::utf8_equal_case(package_file.file_name, file_name)) {
+      return &package_file;
+    }
+  }
+  return nullptr;
+}
