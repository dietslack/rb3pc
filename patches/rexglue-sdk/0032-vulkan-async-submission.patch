+bool VulkanCommandProcessor::RecordAndSubmit(SubmitJob& job) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (dfn.vkResetCommandPool(device, job.command_buffer.pool, 0) != VK_SUCCESS) {
+    REXGPU_ERROR("Failed to reset a Vulkan command pool");
+    return false;
+  }
+  VkCommandBufferBeginInfo command_buffer_begin_info;
+  command_buffer_begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+  command_buffer_begin_info.pNext = nullptr;
+  command_buffer_begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  command_buffer_begin_info.pInheritanceInfo = nullptr;
+  if (dfn.vkBeginCommandBuffer(job.command_buffer.buffer, &command_buffer_begin_info) !=
+      VK_SUCCESS) {
+    REXGPU_ERROR("Failed to begin a Vulkan command buffer");
+    return false;
+  }
+  shared_memory_->RecordPrologue(job.command_buffer.buffer, job.prologue_copies);
+  if (job.command_stream.empty() && std::this_thread::get_id() != submit_thread_.get_id()) {
+    // In place: the commands are still in the deferred command buffer.
+    deferred_command_buffer_.Execute(job.command_buffer.buffer);
+  } else {
+    deferred_command_buffer_.ExecuteStream(job.command_buffer.buffer, job.command_stream);
+  }
+  if (dfn.vkEndCommandBuffer(job.command_buffer.buffer) != VK_SUCCESS) {
+    REXGPU_ERROR("Failed to end a Vulkan command buffer");
+    return false;
+  }
+  VkSubmitInfo submit_info;
+  submit_info.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+  submit_info.pNext = nullptr;
+  if (!job.wait_semaphores.empty()) {
+    submit_info.waitSemaphoreCount = uint32_t(job.wait_semaphores.size());
+    submit_info.pWaitSemaphores = job.wait_semaphores.data();
+    submit_info.pWaitDstStageMask = job.wait_stage_masks.data();
+  } else {
+    submit_info.waitSemaphoreCount = 0;
+    submit_info.pWaitSemaphores = nullptr;
+    submit_info.pWaitDstStageMask = nullptr;
+  }
+  submit_info.commandBufferCount = 1;
+  submit_info.pCommandBuffers = &job.command_buffer.buffer;
+  submit_info.signalSemaphoreCount = 0;
+  submit_info.pSignalSemaphores = nullptr;
+  VkResult submit_result;
+  {
+    ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+        vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+    submit_result = dfn.vkQueueSubmit(queue_acquisition.queue(), 1, &submit_info, job.fence);
+  }
+  if (submit_result != VK_SUCCESS) {
+    REXGPU_ERROR("Failed to submit a Vulkan command buffer");
+    if (submit_result == VK_ERROR_DEVICE_LOST && graphics_system_) {
+      graphics_system_->OnHostGpuLossFromAnyThread(true);
+    }
+    return false;
+  }
+  return true;
+}
+
+void VulkanCommandProcessor::SubmitThreadMain() {
+  std::unique_lock<std::mutex> lock(submit_mutex_);
+  while (true) {
+    submit_job_cv_.wait(lock, [this] { return submit_thread_exit_ || !submit_jobs_.empty(); });
+    if (submit_jobs_.empty()) {
+      return;
+    }
+    SubmitJob job = std::move(submit_jobs_.front());
+    submit_jobs_.pop_front();
+    submit_thread_busy_ = true;
+    lock.unlock();
+    if (!RecordAndSubmit(job)) {
+      // The fence won't be signaled - awaiting it would hang, so treat this
+      // like the device being lost.
+      submit_thread_failed_.store(true, std::memory_order_release);
+    }
+    job.command_stream.clear();
+    lock.lock();
+    free_command_streams_.push_back(std::move(job.command_stream));
+    submit_thread_busy_ = false;
+    if (submit_jobs_.empty()) {
+      submit_idle_cv_.notify_all();
+    }
+  }
+}
+
+void VulkanCommandProcessor::AwaitSubmitThreadIdle() {
+  if (!submit_thread_.joinable()) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(submit_mutex_);
+  submit_idle_cv_.wait(lock, [this] { return submit_jobs_.empty() && !submit_thread_busy_; });
+}
+
+void VulkanCommandProcessor::ShutdownSubmitThread() {
+  if (!submit_thread_.joinable()) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(submit_mutex_);
+    submit_thread_exit_ = true;
+  }
+  submit_job_cv_.notify_one();
+  submit_thread_.join();
+  submit_thread_exit_ = false;
+}
