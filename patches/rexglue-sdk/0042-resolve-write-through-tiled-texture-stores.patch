+// Called by all invocations after StoreGroup, writes the texel tile to the
+// texture, with each 32 invocations writing 16x2 texels.
+void StoreTile(uint invocation_count_x) {
+  if ((c.texture_info & 8u) == 0u) {
+    return;
+  }
+  barrier();
+  uvec2 tile_position = DestPosition(gl_WorkGroupID.xy * uvec2(kTileWidth, 8u)) +
+                        (uvec2(c.texture_origin) >> uvec2(0u, 16u) & 0xFFFFu);
+  for (uint i = 0u; i < kTileWidth / 8u; ++i) {
+    uint index = (i << 6u) + gl_LocalInvocationIndex;
+    uvec2 texel = uvec2((index & 15u) | ((index >> 7u) << 4u), (index >> 4u) & 7u);
+    uvec2 position = tile_position + texel;
+    if (gl_WorkGroupID.x * 8u + texel.x / kPixelsPerInvocation < invocation_count_x &&
+        all(lessThan(position, uvec2(c.texture_width, c.texture_height)))) {
+      imageStore(tex, ivec2(position), uvec4(texel_tile[texel.y * kTileWidth + texel.x], 0u, 0u, 0u));
+    }
+  }
+}
