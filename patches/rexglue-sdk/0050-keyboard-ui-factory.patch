+/**
+ * @file        kernel/xam/keyboard_ui.h
+ * @brief       Replacing the on-screen keyboard (XamShowKeyboardUI) with the
+ *              app's own text entry
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <functional>
+#include <memory>
+#include <string>
+
+struct ImGuiIO;
+
+namespace rex::kernel::xam {
+
+struct KeyboardUiRequest {
+  std::string title;
+  std::string description;
+  std::string default_text;
+  size_t max_length = 0;  // characters, not counting the terminator
+};
+
+// One open keyboard, drawn by the app in place of the SDK's ImGui popup.
+// The title gets no input while it's open (see xeXamIsUIActive).
+class KeyboardUi {
+ public:
+  virtual ~KeyboardUi() = default;
+  // Every frame while open, on the UI thread, inside an ImGui frame. True
+  // when the player has finished (confirmed or cancelled).
+  virtual bool Draw(ImGuiIO& io) = 0;
+  virtual bool cancelled() const = 0;
+  virtual std::string text() const = 0;  // UTF-8
+};
+
+using KeyboardUiFactory = std::function<std::unique_ptr<KeyboardUi>(const KeyboardUiRequest&)>;
+
+// From now on XamShowKeyboardUI opens what `factory` makes (null: the SDK's
+// own popup again).
+void SetKeyboardUiFactory(KeyboardUiFactory factory);
+
+}  // namespace rex::kernel::xam
