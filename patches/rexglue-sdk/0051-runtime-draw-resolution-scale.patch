+spv::Id SpirvShaderTranslator::LoadDrawResolutionScale(uint32_t axis) {
+  id_vector_temp_.clear();
+  id_vector_temp_.push_back(builder_->makeIntConstant(kSystemConstantDrawResolutionScale));
+  id_vector_temp_.push_back(builder_->makeIntConstant(int(axis)));
+  return builder_->createLoad(
+      builder_->createAccessChain(spv::StorageClassUniform, uniform_system_constants_,
+                                  id_vector_temp_),
+      spv::NoPrecision);
+}
