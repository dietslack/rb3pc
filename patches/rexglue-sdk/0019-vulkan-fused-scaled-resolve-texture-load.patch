+      texture_key.dimension != xenos::DataDimension::k2DOrStacked ||
+      texture_key.GetDepthOrArraySize() != 1 || texture_key.mip_max_level != 0 ||
+      guest_layout.packed_level == 0 || texture.force_load_3d_tiling() ||
+      host_format.block_compressed || FormatInfo::Get(texture_key.format)->bytes_per_block() != 4 ||
+      texture.storage_load_format() != VK_FORMAT_R32_UINT) {
+    return false;
