+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  VkDescriptorSet descriptor_set_dest = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageImageCompute);
+  if (descriptor_set_source == VK_NULL_HANDLE || descriptor_set_dest == VK_NULL_HANDLE) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  VkDescriptorBufferInfo source_info = {scaled_resolve_buffer_, source_start, source_range};
+  VkDescriptorImageInfo dest_info = {VK_NULL_HANDLE, storage_view, VK_IMAGE_LAYOUT_GENERAL};
+  VkWriteDescriptorSet writes[2] = {};
+  writes[0].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  writes[0].dstSet = descriptor_set_source;
+  writes[0].descriptorCount = 1;
+  writes[0].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  writes[0].pBufferInfo = &source_info;
+  writes[1].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  writes[1].dstSet = descriptor_set_dest;
+  writes[1].descriptorCount = 1;
+  writes[1].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  writes[1].pImageInfo = &dest_info;
+  vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(), 2, writes, 0,
+                                                    nullptr);
+
+  UseScaledResolveBufferForRead();
+  texture.MarkAsUsed();
+  VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kStorageDestination);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kStorageDestination, dst_stage_mask,
+                       dst_access_mask, new_layout);
+  // The whole image is overwritten, so its old contents can be dropped.
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(),
+      src_stage_mask ? src_stage_mask : VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, dst_stage_mask, 0,
+      dst_access_mask, VK_IMAGE_LAYOUT_UNDEFINED, new_layout);
+  command_processor_.SubmitBarriers(true);
+
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(pipeline);
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         fused_load_pipeline_layout_, 0, 1,
+                                         &descriptor_set_source, 0, nullptr);
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         fused_load_pipeline_layout_, 1, 1, &descriptor_set_dest,
+                                         0, nullptr);
+  uint32_t scale_x = draw_resolution_scale_x(), scale_y = draw_resolution_scale_y();
+  uint32_t constants[5] = {
+      (uint32_t(texture_key.endianness) << 2) | (scale_x << 4) | (scale_y << 7),
+      guest_layout.base.row_pitch_bytes / 4, texture_key.GetWidth() * scale_x,
+      texture_key.GetHeight() * scale_y, 0};
+  command_buffer.CmdVkPushConstants(fused_load_pipeline_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(constants), constants);
+  command_buffer.CmdVkDispatch((constants[2] + 31) / 32, (constants[3] + 15) / 16, 1);
+  return true;
+}
