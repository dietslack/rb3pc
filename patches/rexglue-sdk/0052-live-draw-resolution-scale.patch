+void VulkanTextureCache::NoteScaledResolve(uint32_t start_unscaled, uint32_t length_unscaled,
+                                           uint32_t bpe_log2) {
+  if (!length_unscaled) {
+    return;
+  }
+  uint32_t end = start_unscaled + length_unscaled;
+  auto it = noted_scaled_resolves_.lower_bound(start_unscaled);
+  // Cut out the part the new range covers from the ranges it overlaps.
+  if (it != noted_scaled_resolves_.begin()) {
+    auto previous = std::prev(it);
+    if (previous->second.end > start_unscaled) {
+      if (previous->second.end > end) {
+        noted_scaled_resolves_.emplace(end, previous->second);
+      }
+      previous->second.end = start_unscaled;
+    }
+  }
+  while (it != noted_scaled_resolves_.end() && it->first < end) {
+    if (it->second.end > end) {
+      NotedScaledResolve rest = it->second;
+      noted_scaled_resolves_.erase(it);
+      noted_scaled_resolves_.emplace(end, rest);
+      break;
+    }
+    it = noted_scaled_resolves_.erase(it);
+  }
+  noted_scaled_resolves_[start_unscaled] = {end, bpe_log2};
+}
+
+std::vector<VulkanTextureCache::ScaledResolveRun> VulkanTextureCache::GetScaledResolveRuns() {
+  std::vector<ScaledResolveRun> runs;
+  for (auto it = noted_scaled_resolves_.begin(); it != noted_scaled_resolves_.end();) {
+    uint32_t run_start = UINT32_MAX;
+    uint32_t page_end;
+    for (uint32_t address = it->first; address < it->second.end; address = page_end) {
+      page_end = std::min((address & ~UINT32_C(4095)) + 4096, it->second.end);
+      bool scaled = HasScaledResolveData(address, page_end - address);
+      if (scaled && run_start == UINT32_MAX) {
+        run_start = address;
+      }
+      if ((!scaled || page_end == it->second.end) && run_start != UINT32_MAX) {
+        uint32_t run_end = scaled ? page_end : address;
+        runs.push_back({run_start, run_end - run_start, it->second.bpe_log2});
+        run_start = UINT32_MAX;
+      }
+    }
+    // Overwritten by the CPU entirely.
+    bool any_left = !runs.empty() && runs.back().start >= it->first;
+    it = any_left ? std::next(it) : noted_scaled_resolves_.erase(it);
+  }
+  return runs;
+}
