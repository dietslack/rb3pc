+bool VulkanRenderTargetCache::EnsureUnscaledResolvePipelines() {
+  if (!unscaled_resolve_pipelines_pending_) {
+    return true;
+  }
+  unscaled_resolve_pipelines_pending_ = false;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  // Not used by any submission yet (no resolve has been done at this scale).
+  for (size_t i = 0; i < size_t(draw_util::ResolveCopyShaderIndex::kCount); ++i) {
+    const ResolveCopyShaderCode& resolve_copy_shader_code = kResolveCopyShaders[i];
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device,
+                                           resolve_copy_pipelines_[i]);
+    resolve_copy_pipelines_[i] = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device, resolve_copy_pipeline_layout_, resolve_copy_shader_code.unscaled,
+        resolve_copy_shader_code.unscaled_size_bytes);
+    if (resolve_copy_pipelines_[i] == VK_NULL_HANDLE) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the resolve copy pipeline {}",
+                   draw_util::resolve_copy_shader_info[i].debug_name);
+      return false;
+    }
+    vulkan_device->SetObjectName(VK_OBJECT_TYPE_PIPELINE, resolve_copy_pipelines_[i],
+                                 draw_util::resolve_copy_shader_info[i].debug_name);
+  }
+  if (GetPath() == Path::kPixelShaderInterlock) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device,
+                                           resolve_fsi_clear_32bpp_pipeline_);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device,
+                                           resolve_fsi_clear_64bpp_pipeline_);
+    resolve_fsi_clear_32bpp_pipeline_ = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device, resolve_fsi_clear_pipeline_layout_, shaders::resolve_clear_32bpp_cs,
+        sizeof(shaders::resolve_clear_32bpp_cs));
+    resolve_fsi_clear_64bpp_pipeline_ = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device, resolve_fsi_clear_pipeline_layout_, shaders::resolve_clear_64bpp_cs,
+        sizeof(shaders::resolve_clear_64bpp_cs));
+    if (resolve_fsi_clear_32bpp_pipeline_ == VK_NULL_HANDLE ||
+        resolve_fsi_clear_64bpp_pipeline_ == VK_NULL_HANDLE) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the resolve EDRAM buffer clear "
+                   "pipelines");
+      return false;
+    }
+  }
+  return true;
+}
