+bool VulkanCommandProcessor::RequestDrawResolutionScale(uint32_t scale_x, uint32_t scale_y) {
+  if (!scale_x || !scale_y || scale_x > TextureCache::kMaxDrawResolutionScaleAlongAxis ||
+      scale_y > TextureCache::kMaxDrawResolutionScaleAlongAxis) {
+    return false;
+  }
+  // Pipelines made for render passes would refer to the render target cache's
+  // ones, which are recreated.
+  if (!REXCVAR_GET(vulkan_dynamic_rendering) || !GetVulkanDevice()->properties().dynamicRendering) {
+    return false;
+  }
+  requested_draw_resolution_scale_.store(scale_x | (scale_y << 8), std::memory_order_release);
+  return true;
+}
+
+void VulkanCommandProcessor::ApplyRequestedDrawResolutionScale() {
+  uint32_t requested = requested_draw_resolution_scale_.exchange(0, std::memory_order_acq_rel);
+  uint32_t scale_x = requested & 0xFF;
+  uint32_t scale_y = (requested >> 8) & 0xFF;
+  uint32_t old_scale_x = texture_cache_->draw_resolution_scale_x();
+  uint32_t old_scale_y = texture_cache_->draw_resolution_scale_y();
+  if (!requested || (scale_x == old_scale_x && scale_y == old_scale_y)) {
+    return;
+  }
+  REXGPU_INFO("Changing the draw resolution scale from {}x{} to {}x{}", old_scale_x, old_scale_y,
+              scale_x, scale_y);
+  applying_draw_resolution_scale_ = true;
+
+  // Resolves written only to textures, to the scaled resolve buffer.
+  texture_cache_->FlushDeferredResolveStores(0, SharedMemory::kBufferSize);
+  std::unique_ptr<VulkanTextureCache> new_texture_cache =
+      VulkanTextureCache::Create(*register_file_, *shared_memory_, scale_x, scale_y, *this,
+                                 guest_shader_pipeline_stages_);
+  if (!new_texture_cache) {
+    REXGPU_ERROR("Failed to create the texture cache at the new draw resolution scale");
+    applying_draw_resolution_scale_ = false;
+    return;
+  }
+  CarryOverScaledResolves(*texture_cache_, *new_texture_cache);
+
+  // Nothing may be using the old caches' objects when they're destroyed.
+  if (!EndSubmission(false) || !AwaitAllQueueOperationsCompletion()) {
+    REXGPU_ERROR("Failed to await the GPU before changing the draw resolution scale");
+  }
+  texture_cache_ = std::move(new_texture_cache);
+
+  render_target_cache_->Shutdown();
+  render_target_cache_->SetDrawResolutionScale(scale_x, scale_y);
+  if (!render_target_cache_->Initialize(shared_memory_binding_count_)) {
+    REXGPU_ERROR("Failed to initialize the render target cache at the new draw resolution scale");
+    // Can't draw without it.
+    device_lost_ = true;
+    applying_draw_resolution_scale_ = false;
+    return;
+  }
+  if (render_target_cache_->GetPath() == RenderTargetCache::Path::kPixelShaderInterlock) {
+    // The EDRAM buffer is sized for the scale.
+    const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+    VkDescriptorBufferInfo edram_descriptor_buffer_info;
+    edram_descriptor_buffer_info.buffer = render_target_cache_->edram_buffer();
+    edram_descriptor_buffer_info.offset = 0;
+    edram_descriptor_buffer_info.range = VK_WHOLE_SIZE;
+    VkWriteDescriptorSet write_descriptor_set_edram;
+    write_descriptor_set_edram.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    write_descriptor_set_edram.pNext = nullptr;
+    write_descriptor_set_edram.dstSet = shared_memory_and_edram_descriptor_set_;
+    write_descriptor_set_edram.dstBinding = 1;
+    write_descriptor_set_edram.dstArrayElement = 0;
+    write_descriptor_set_edram.descriptorCount = 1;
+    write_descriptor_set_edram.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    write_descriptor_set_edram.pImageInfo = nullptr;
+    write_descriptor_set_edram.pBufferInfo = &edram_descriptor_buffer_info;
+    write_descriptor_set_edram.pTexelBufferView = nullptr;
+    vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(), 1,
+                                                      &write_descriptor_set_edram, 0, nullptr);
+  }
+
+  applying_draw_resolution_scale_ = false;
+  // Continue the frame.
+  BeginSubmission(false);
+  texture_cache_->BeginFrame();
+}
+
+void VulkanCommandProcessor::CarryOverScaledResolves(VulkanTextureCache& from,
+                                                     VulkanTextureCache& to) {
+  if (!from.IsDrawResolutionScaled()) {
+    // Resolves are in the shared memory at 1x already.
+    return;
+  }
+  std::vector<VulkanTextureCache::ScaledResolveRun> runs = from.GetScaledResolveRuns();
+  if (runs.empty()) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  struct ResampleConstants {
+    // X in 0:3, Y in 4:7.
+    uint32_t source_scale;
+    uint32_t dest_scale;
+    uint32_t bpe_log2;
+    uint32_t dest_dword_count;
+    // Of the range within the bound part of the buffers.
+    uint32_t source_base_dwords;
+    uint32_t dest_base_dwords;
+  };
+  if (scaled_resolve_resample_pipeline_ == VK_NULL_HANDLE) {
+    if (scaled_resolve_resample_pipeline_layout_ == VK_NULL_HANDLE) {
+      VkDescriptorSetLayout set_layouts[2];
+      set_layouts[0] = set_layouts[1] =
+          GetSingleTransientDescriptorLayout(SingleTransientDescriptorLayout::kStorageBufferCompute);
+      VkPushConstantRange push_constant_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                                 sizeof(ResampleConstants)};
+      VkPipelineLayoutCreateInfo layout_create_info = {};
+      layout_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+      layout_create_info.setLayoutCount = 2;
+      layout_create_info.pSetLayouts = set_layouts;
+      layout_create_info.pushConstantRangeCount = 1;
+      layout_create_info.pPushConstantRanges = &push_constant_range;
+      if (dfn.vkCreatePipelineLayout(device, &layout_create_info, nullptr,
+                                     &scaled_resolve_resample_pipeline_layout_) != VK_SUCCESS) {
+        scaled_resolve_resample_pipeline_layout_ = VK_NULL_HANDLE;
+      }
+    }
+    static constexpr const char kResampleSource[] = R"(#version 450
+// One invocation per destination dword.
+layout(local_size_x = 256) in;
+layout(push_constant) uniform Constants {
+  uint source_scale;
+  uint dest_scale;
+  uint bpe_log2;
+  uint dest_dword_count;
+  uint source_base_dwords;
+  uint dest_base_dwords;
+} c;
+layout(std430, set = 0, binding = 0) readonly buffer Source { uint source[]; };
+layout(std430, set = 1, binding = 0) writeonly buffer Dest { uint dest[]; };
+
+// Resolution-scaled layout: each guest chunk (8 bytes at 8bpp, 16 otherwise)
+// holds scale.x * scale.y host chunks, column-major, each a row of host pixels.
+// Nearest-neighbor: the byte of the source that the destination byte samples.
+uint SourceByte(uint dest_byte, uvec2 ss, uvec2 ds) {
+  uint chunk_log2 = c.bpe_log2 == 0u ? 3u : 4u;
+  uint pixels_log2 = chunk_log2 - c.bpe_log2;
+  uint dest_guest_chunk_size = (ds.x * ds.y) << chunk_log2;
+  uint guest_chunk = dest_byte / dest_guest_chunk_size;
+  uint in_guest = dest_byte - guest_chunk * dest_guest_chunk_size;
+  uint host_chunk = in_guest >> chunk_log2;
+  uint in_chunk = in_guest & ((1u << chunk_log2) - 1u);
+  uvec2 host = uvec2(((host_chunk / ds.y) << pixels_log2) + (in_chunk >> c.bpe_log2),
+                     host_chunk % ds.y);
+  uvec2 guest_pixel = host / ds;
+  uvec2 source_host = guest_pixel * ss + (host - guest_pixel * ds) * ss / ds;
+  uint source_chunk = (source_host.x >> pixels_log2) * ss.y + source_host.y;
+  return guest_chunk * ((ss.x * ss.y) << chunk_log2) + (source_chunk << chunk_log2) +
+         ((source_host.x & ((1u << pixels_log2) - 1u)) << c.bpe_log2) +
+         (in_chunk & ((1u << c.bpe_log2) - 1u));
+}
+
+void main() {
+  uint index = gl_GlobalInvocationID.x;
+  if (index >= c.dest_dword_count) {
+    return;
+  }
+  uvec2 ss = (uvec2(c.source_scale) >> uvec2(0u, 4u)) & 15u;
+  uvec2 ds = (uvec2(c.dest_scale) >> uvec2(0u, 4u)) & 15u;
+  uint value = 0u;
+  if (c.bpe_log2 >= 2u) {
+    value = source[c.source_base_dwords + (SourceByte(index << 2u, ss, ds) >> 2u)];
+  } else {
+    for (uint i = 0u; i < 4u; ++i) {
+      uint byte_address = SourceByte((index << 2u) + i, ss, ds);
+      uint word = source[c.source_base_dwords + (byte_address >> 2u)];
+      value |= ((word >> ((byte_address & 3u) << 3u)) & 0xFFu) << (i << 3u);
+    }
+  }
+  dest[c.dest_base_dwords + index] = value;
+}
+)";
+    std::vector<uint32_t> spirv;
+    std::string error;
+    if (scaled_resolve_resample_pipeline_layout_ != VK_NULL_HANDLE) {
+      if (CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, kResampleSource, spirv, error)) {
+        scaled_resolve_resample_pipeline_ = ui::vulkan::util::CreateComputePipeline(
+            vulkan_device, scaled_resolve_resample_pipeline_layout_, spirv.data(),
+            spirv.size() * sizeof(uint32_t));
+      } else {
+        REXGPU_WARN("Failed to compile the scaled resolve resampling shader: {}", error);
+      }
+    }
+    if (scaled_resolve_resample_pipeline_ == VK_NULL_HANDLE) {
+      REXGPU_WARN("Resolution-scaled resolves won't be carried over to the new scale");
+      return;
+    }
+  }
+
+  VkDeviceSize offset_alignment =
+      std::max(vulkan_device->properties().minStorageBufferOffsetAlignment, VkDeviceSize(4));
+  uint32_t from_scale = from.draw_resolution_scale_x() | (from.draw_resolution_scale_y() << 4);
+  uint32_t to_scale = to.draw_resolution_scale_x() | (to.draw_resolution_scale_y() << 4);
+  BindExternalComputePipeline(scaled_resolve_resample_pipeline_);
+  from.UseScaledResolveBufferForRead();
+  auto resample = [&](uint64_t source_start, uint64_t source_length, VkBuffer dest_buffer,
+                      uint64_t dest_start, uint64_t dest_length, uint32_t dest_scale,
+                      uint32_t bpe_log2) {
+    VkDescriptorSet sets[2];
+    VkDescriptorBufferInfo buffer_infos[2];
+    VkWriteDescriptorSet writes[2];
+    uint32_t base_dwords[2];
+    VkBuffer buffers[] = {from.scaled_resolve_buffer(), dest_buffer};
+    uint64_t starts[] = {source_start, dest_start};
+    uint64_t lengths[] = {source_length, dest_length};
+    for (uint32_t i = 0; i < 2; ++i) {
+      sets[i] = AllocateSingleTransientDescriptor(
+          SingleTransientDescriptorLayout::kStorageBufferCompute);
+      if (sets[i] == VK_NULL_HANDLE) {
+        return false;
+      }
+      uint64_t bind_start = starts[i] / offset_alignment * offset_alignment;
+      base_dwords[i] = uint32_t((starts[i] - bind_start) >> 2);
+      buffer_infos[i].buffer = buffers[i];
+      buffer_infos[i].offset = bind_start;
+      buffer_infos[i].range = starts[i] + lengths[i] - bind_start;
+      writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+      writes[i].pNext = nullptr;
+      writes[i].dstSet = sets[i];
+      writes[i].dstBinding = 0;
+      writes[i].dstArrayElement = 0;
+      writes[i].descriptorCount = 1;
+      writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+      writes[i].pImageInfo = nullptr;
+      writes[i].pBufferInfo = &buffer_infos[i];
+      writes[i].pTexelBufferView = nullptr;
+    }
+    dfn.vkUpdateDescriptorSets(device, 2, writes, 0, nullptr);
+    deferred_command_buffer_.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                                     scaled_resolve_resample_pipeline_layout_, 0,
+                                                     2, sets, 0, nullptr);
+    ResampleConstants constants;
+    constants.source_scale = from_scale;
+    constants.dest_scale = dest_scale;
+    constants.bpe_log2 = bpe_log2;
+    constants.dest_dword_count = uint32_t(dest_length >> 2);
+    constants.source_base_dwords = base_dwords[0];
+    constants.dest_base_dwords = base_dwords[1];
+    deferred_command_buffer_.CmdVkPushConstants(scaled_resolve_resample_pipeline_layout_,
+                                                VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
+                                                &constants);
+    SubmitBarriers(true);
+    deferred_command_buffer_.CmdVkDispatch((constants.dest_dword_count + 255) / 256, 1, 1);
+    return true;
+  };
+
+  // Pieces small enough for the dispatch group count limit.
+  constexpr uint32_t kPieceLength = 1 << 20;
+  uint64_t carried_length = 0;
+  for (const VulkanTextureCache::ScaledResolveRun& run : runs) {
+    uint32_t start = run.start & ~UINT32_C(15);
+    uint32_t end = std::min(rex::align(run.start + run.length, UINT32_C(16)),
+                            SharedMemory::kBufferSize);
+    bool carried_to_scaled = to.IsDrawResolutionScaled();
+    for (uint32_t piece = start; piece < end; piece += kPieceLength) {
+      uint32_t piece_length = std::min(end - piece, kPieceLength);
+      uint64_t source_start, source_length;
+      if (!from.GetScaledResolveRange(piece, piece_length, 0, source_start, source_length)) {
+        carried_to_scaled = false;
+        continue;
+      }
+      // Into the shared memory at 1x, for the new cache's unscaled textures.
+      if (shared_memory_->RequestRange(piece, piece_length)) {
+        shared_memory_->Use(VulkanSharedMemory::Usage::kComputeWrite,
+                            std::make_pair(piece, piece_length));
+        resample(source_start, source_length, shared_memory_->buffer(), piece, piece_length,
+                 1 | (1 << 4), run.bpe_log2);
+      }
+      uint64_t dest_start, dest_length;
+      if (carried_to_scaled) {
+        carried_to_scaled =
+            to.CommitScaledResolveRange(piece, piece_length) &&
+            to.GetScaledResolveRange(piece, piece_length, 0, dest_start, dest_length);
+        if (carried_to_scaled) {
+          to.UseScaledResolveBufferForWrite(dest_start, dest_length);
+          carried_to_scaled = resample(source_start, source_length, to.scaled_resolve_buffer(),
+                                       dest_start, dest_length, to_scale, run.bpe_log2);
+        }
+      }
+    }
+    if (carried_to_scaled) {
+      to.MarkRangeAsResolved(start, end - start);
+      to.NoteScaledResolve(start, end - start, run.bpe_log2);
+    }
+    carried_length += end - start;
+  }
+  REXGPU_INFO("Carried {} KB of resolution-scaled resolves over to the new scale",
+              carried_length >> 10);
