-    if (!translation->is_translated() &&
-        !TranslateAnalyzedShader(*shader_translator_, *translation)) {
-      if (translation_is_new) {
-        shader->DestroyTranslation(translation_needed.second);
+  }
+  {
+    uint32_t processors = std::max(rex::thread::logical_processor_count(), uint32_t(1));
+    size_t thread_count =
+        std::min(size_t(std::max(processors * 3 / 4, uint32_t(1))), translation_groups.size());
+    std::atomic<size_t> next_group(0);
+    auto translate_worker = [this, &pending_translations, &translation_groups, &next_group]() {
+      std::unique_ptr<SpirvShaderTranslator> translator = CreateShaderTranslator();
+      while (true) {
+        size_t group = next_group.fetch_add(1);
+        if (group >= translation_groups.size()) break;
+        for (size_t index : translation_groups[group]) {
+          PendingTranslation& pending = pending_translations[index];
+          pending.translated = TranslateShaderToModule(*translator, *pending.translation);
+        }
+      }
+    };
+    if (thread_count <= 1) {
+      translate_worker();
+    } else {
+      std::vector<std::unique_ptr<rex::thread::Thread>> translate_threads;
+      for (size_t i = 0; i < thread_count; ++i) {
+        auto thread = rex::thread::Thread::Create({}, translate_worker);
+        assert_not_null(thread);
+        thread->set_name("Shader Translation");
+        translate_threads.push_back(std::move(thread));
+      }
+      for (const auto& thread : translate_threads) {
+        rex::thread::Wait(thread.get(), false);
       }
     }
