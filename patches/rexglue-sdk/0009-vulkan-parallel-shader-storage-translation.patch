+  // Translate shader modifications needed for stored pipelines. Translation
+  // to SPIR-V is the slow part (about a second for RB3's ~500 stored
+  // pipelines on one thread), so it's spread over threads, one shader's
+  // translations per task; looking shaders up and the binding layout
+  // bookkeeping stay on this thread.
+  struct PendingTranslation {
+    VulkanShader* shader;
+    VulkanShader::VulkanTranslation* translation;
+    uint64_t modification;
+    bool is_new;
+    bool translated;
+  };
+  std::vector<PendingTranslation> pending_translations;
+  std::vector<std::vector<size_t>> translation_groups;  // indices, grouped by shader
+  {
+    std::unordered_map<VulkanShader*, size_t> group_of_shader;
+    for (const std::pair<uint64_t, uint64_t>& translation_needed : shader_translations_needed) {
+      auto shader_it = shaders_.find(translation_needed.first);
+      if (shader_it == shaders_.end()) {
+        continue;
+      }
+      auto* shader = shader_it->second;
+      if (!shader->is_ucode_analyzed()) {
+        shader->AnalyzeUcode(ucode_disasm_buffer_);
+      }
+      bool translation_is_new = false;
+      auto* translation = static_cast<VulkanShader::VulkanTranslation*>(
+          shader->GetOrCreateTranslation(translation_needed.second, &translation_is_new));
+      if (translation->is_translated()) {
+        continue;
+      }
+      auto [group_it, inserted] = group_of_shader.emplace(shader, translation_groups.size());
+      if (inserted) translation_groups.emplace_back();
+      translation_groups[group_it->second].push_back(pending_translations.size());
+      pending_translations.push_back(
+          {shader, translation, translation_needed.second, translation_is_new, false});
     }
-    bool translation_is_new = false;
-    auto* translation = static_cast<VulkanShader::VulkanTranslation*>(
