diff --git a/src/graphics/register_file.cpp b/src/graphics/register_file.cpp
index 03ce18c..3823d08 100644
--- a/src/graphics/register_file.cpp
+++ b/src/graphics/register_file.cpp
@@ -9,6 +9,7 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <bitset>
 #include <cstring>
 
 #include <rex/graphics/register_file.h>
@@ -16,6 +17,25 @@
 
 namespace rex::graphics {
 
+namespace {
+
+// Built when the library loads, so lookups don't pay for GetRegisterInfo's
+// switch and its function-local statics' initialization checks.
+const std::bitset<RegisterFile::kRegisterCount> kKnownRegisters = [] {
+  std::bitset<RegisterFile::kRegisterCount> known;
+#define XE_GPU_REGISTER(index, type, name) \
+  if ((index) < RegisterFile::kRegisterCount) known.set(index);
+#include <rex/graphics/register_table.inc>
+#undef XE_GPU_REGISTER
+  return known;
+}();
+
+}  // namespace
+
+bool RegisterFile::IsKnownRegister(uint32_t index) {
+  return index < kRegisterCount && kKnownRegisters.test(index);
+}
+
 RegisterFile::RegisterFile() {
   std::memset(values, 0, sizeof(values));
 }
