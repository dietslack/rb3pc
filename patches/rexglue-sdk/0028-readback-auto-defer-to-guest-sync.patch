+void VulkanCommandProcessor::FlushPendingReadbacks() {
+  if (pending_readbacks_.empty()) {
+    return;
+  }
+  // Moved out first: the wait ends the submission, which may come back here.
+  std::vector<PendingReadback> pending;
+  pending.swap(pending_readbacks_);
+  if (!AwaitAllQueueOperationsCompletion()) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (const PendingReadback& p : pending) {
+    auto it = readback_buffers_.find(p.key);
+    if (it == readback_buffers_.end()) {
+      continue;
+    }
+    ReadbackBuffer& readback = it->second;
+    if (readback.memories[p.index] == VK_NULL_HANDLE || readback.mapped_data[p.index] == nullptr ||
+        p.length > readback.sizes[p.index]) {
+      continue;
+    }
+    VkMappedMemoryRange range = {};
+    range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    range.memory = readback.memories[p.index];
+    range.offset = 0;
+    range.size = VK_WHOLE_SIZE;
+    dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+    if (uint8_t* destination = memory_->TranslatePhysical(p.address)) {
+      std::memcpy(destination, readback.mapped_data[p.index], p.length);
+    }
+  }
+}
